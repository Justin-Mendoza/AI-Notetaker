# Copy to .env for the API and local services. Values below are placeholders.
DATABASE_URL=postgresql+psycopg://meeting_notes:change-me@localhost:5432/meeting_notes
POSTGRES_PASSWORD=change-me
ALLOWED_WEB_ORIGIN=http://localhost:3000
BUCKET_ENDPOINT=http://localhost:9000
BUCKET_NAME=meeting-audio
BUCKET_ACCESS_KEY=change-me
BUCKET_SECRET_KEY=change-me
OPENAI_API_KEY=
STT_PROVIDER=whisper_local
STT_MODEL=gpt-4o-transcribe
WHISPER_LOCAL_BASE_URL=http://127.0.0.1:7777/v1
WHISPER_LOCAL_MODEL_LABEL=base
SUMMARY_PROVIDER=kyma
SUMMARY_MODEL=gpt-4o-mini
KYMA_API_KEY=your-server-only-key
KYMA_BASE_URL=https://kymaapi.com/v1
KYMA_SUMMARY_MODEL=qwen3.7-flash
RAW_AUDIO_RETENTION_HOURS=24
FAILED_AUDIO_RETENTION_DAYS=7
MAX_MEETINGS_PER_HOUR=20
MAX_UPLOADS_PER_HOUR=10
MAX_MANUAL_RETRIES_PER_HOUR=3
METRICS_TOKEN=change-me-for-hosted-monitoring
